{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermesapp.dev/schemas/widgets/common.schema.json",
  "title": "Shared definitions for widget payloads",
  "$defs": {
    "State": {
      "enum": [
        "ok",
        "info",
        "warning",
        "critical",
        "unverified",
        "stale",
        "pending"
      ],
      "description": "The state vocabulary for items (rows, tiles, criteria). An item may be stale when its own data is old."
    },
    "WidgetState": {
      "enum": [
        "ok",
        "info",
        "warning",
        "critical",
        "unverified",
        "pending"
      ],
      "description": "The widget’s own state. Never stale: the client computes that from as_of + stale_after."
    },
    "Text": {
      "type": "string",
      "maxLength": 280,
      "description": "Plain text, one line in most places. No Markdown."
    },
    "Label": {
      "type": "string",
      "maxLength": 40,
      "description": "A short label: buttons, tags, column titles.",
      "minLength": 1
    },
    "RichText": {
      "type": "string",
      "maxLength": 1200,
      "description": "Text with the inline Markdown subset: **bold**, *italic*, `code`, [links](https://…). No headings, lists or images."
    },
    "Symbol": {
      "type": "string",
      "maxLength": 64,
      "description": "An SF Symbol name from the allowlist in docs/widgets/payload-contract.md §7, or bot:<handle> for a Bot face.",
      "pattern": "^(bot:[a-z0-9-]{1,40}|[a-z0-9]+(\\.[a-z0-9]+)*)$"
    },
    "Time": {
      "type": "string",
      "maxLength": 40,
      "description": "RFC 3339 date-time with seconds and an offset, e.g. 2026-10-16T09:41:00-04:00.",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "Date": {
      "type": "string",
      "maxLength": 10,
      "description": "ISO 8601 calendar date, e.g. 2026-10-16.",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Seconds": {
      "type": "number",
      "description": "A duration in seconds.",
      "minimum": 0
    },
    "Url": {
      "type": "string",
      "maxLength": 2048,
      "description": "An https URL (no user info, no spaces), or hermes-file:<path> for a file in the gateway workspace (relative, no ..). Opened only after the person taps and sees where it goes.",
      "pattern": "^(https://[^\\s@/?#]+(/[^\\s]*)?|hermes-file:(?!/)(?!.*\\.\\.)[^\\s]+)$"
    },
    "Id": {
      "type": "string",
      "maxLength": 40,
      "description": "A stable id: lowercase letters, digits, - _ . ; starts with a letter.",
      "pattern": "^[a-z][a-z0-9_.-]{0,39}$"
    },
    "Quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "description": "The raw value: a number; an RFC 3339 time for format countdown / date / time / datetime / relative, or an ISO date for date and relative (relative reads “in 4 days”, “3 days late” from the reader’s now); text for format text; null when unknown (the client shows — and never 0)."
        },
        "unit": {
          "type": "string",
          "maxLength": 16,
          "description": "Unit shown after the value: steps, bpm, °C, GB. Not for currency (use currency)."
        },
        "format": {
          "enum": [
            "number",
            "integer",
            "percent",
            "currency",
            "duration",
            "countdown",
            "date",
            "time",
            "datetime",
            "relative",
            "bytes",
            "text"
          ],
          "description": "How the client formats value for the reader’s locale. percent takes a fraction: 0.12 is 12%.",
          "default": "number"
        },
        "currency": {
          "type": "string",
          "maxLength": 3,
          "description": "ISO 4217 code for format currency.",
          "pattern": "^[A-Z]{3}$"
        },
        "precision": {
          "type": "integer",
          "description": "Fraction digits to show.",
          "minimum": 0,
          "maximum": 4
        },
        "display": {
          "type": "string",
          "maxLength": 32,
          "description": "A pre-formatted string the client shows instead of formatting value itself. Use only when value can’t express it."
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "description": "A value with how to show it. The client formats it; fallback_text carries a formatted copy."
    },
    "Delta": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "The change, signed."
        },
        "format": {
          "enum": [
            "number",
            "percent",
            "currency",
            "points"
          ],
          "description": "How to show the change. percent takes a fraction: 0.12 is +12%.",
          "default": "percent"
        },
        "currency": {
          "type": "string",
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "good": {
          "enum": [
            "up",
            "down",
            "neutral"
          ],
          "description": "Which direction is good. Colours the delta: up is green only when good is up. Required so a cost going up is never shown green."
        },
        "period": {
          "type": "string",
          "maxLength": 40,
          "description": "What it is compared with: “vs last week”."
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "good"
      ],
      "description": "A change. The arrow comes from the sign, the colour from good."
    },
    "Tag": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 24,
          "minLength": 1
        },
        "state": {
          "enum": [
            "neutral",
            "ok",
            "info",
            "warning",
            "critical",
            "unverified",
            "new",
            "removed"
          ],
          "default": "neutral"
        }
      },
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "description": "A small label on a row or card."
    },
    "Media": {
      "type": "object",
      "properties": {
        "src": {
          "$ref": "#/$defs/Url"
        },
        "alt": {
          "type": "string",
          "maxLength": 200,
          "description": "What the image shows, for VoiceOver and when it can’t load. Required.",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio"
          ],
          "default": "image"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration": {
          "$ref": "#/$defs/Seconds"
        },
        "thumb": {
          "$ref": "#/$defs/Url"
        }
      },
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "description": "An image, video or audio file. Gateway files load directly; remote (https) media waits for a tap that shows the domain, until the gateway can serve a stored copy (payload-contract.md §9)."
    },
    "Leading": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "symbol",
            "image",
            "avatar",
            "face",
            "date",
            "map",
            "file",
            "rank",
            "logo"
          ],
          "description": "What sits at the leading edge of a row or entity."
        },
        "symbol": {
          "$ref": "#/$defs/Symbol"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "initials": {
          "type": "string",
          "maxLength": 3
        },
        "bot": {
          "type": "string",
          "maxLength": 40,
          "description": "A Bot handle for kind face."
        },
        "date": {
          "$ref": "#/$defs/Date"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "file_type": {
          "type": "string",
          "maxLength": 8,
          "description": "Extension for kind file: pdf, docx, csv…"
        },
        "location": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "label": {
              "type": "string",
              "maxLength": 80
            }
          },
          "additionalProperties": false,
          "required": [
            "lat",
            "lon"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "A leading visual. The client draws maps and faces itself."
    },
    "Person": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "initials": {
          "type": "string",
          "maxLength": 3
        },
        "avatar": {
          "$ref": "#/$defs/Media"
        },
        "bot": {
          "type": "string",
          "maxLength": 40,
          "description": "Set when the person is one of the user’s Bots: its handle."
        },
        "role": {
          "type": "string",
          "maxLength": 80
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "Someone, or one of the user’s Bots."
    },
    "Action": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "type": "string",
          "maxLength": 28,
          "description": "The button text, a verb: Approve, Book a Viewing.",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "reply",
            "open",
            "copy"
          ],
          "description": "reply sends the agent a structured message (the default); open opens url on this device after showing where it goes; copy puts value on the clipboard.",
          "default": "reply"
        },
        "style": {
          "enum": [
            "primary",
            "secondary",
            "destructive"
          ],
          "description": "At most one primary per widget.",
          "default": "secondary"
        },
        "url": {
          "$ref": "#/$defs/Url"
        },
        "value": {
          "type": "string",
          "maxLength": 2000,
          "description": "For copy."
        },
        "confirm": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 80
            },
            "message": {
              "type": "string",
              "maxLength": 280
            }
          },
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "description": "Ask before sending. Required for destructive."
        },
        "requires": {
          "enum": [
            "none",
            "authentication"
          ],
          "description": "authentication asks for Face ID / Touch ID / the passcode before sending.",
          "default": "none"
        },
        "payload": {
          "type": "object",
          "description": "Opaque data echoed back to the agent with the action (≤ 1 KB). Never shown, never trusted as the user’s words."
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "description": "A button. Never executes anything in the client."
    },
    "Source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "Where the data came from: App Store Connect, Apple Health, streeteasy.com.",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "api",
            "web",
            "file",
            "tool",
            "device",
            "human",
            "agent"
          ]
        },
        "url": {
          "$ref": "#/$defs/Url"
        },
        "detail": {
          "type": "string",
          "maxLength": 120
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "Provenance, shown in the footer."
    },
    "Refresh": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "payload",
            "agent"
          ],
          "description": "agent: the widget menu has Refresh, which sends the agent a refresh action (costs a turn; never automatic). payload: reserved; needs a gateway RPC, treated as none until then (payload-contract.md §5).",
          "default": "none"
        },
        "every": {
          "type": "integer",
          "description": "For payload: minimum seconds between re-reads while visible.",
          "minimum": 60
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "test",
            "file",
            "link",
            "data",
            "observation",
            "claim"
          ],
          "description": "How it is known: a test run, a file, a web page, a data source, something the agent saw (a photo, a screen), or a claim (someone said so: shown as “Said by …”, never as checked)."
        },
        "label": {
          "type": "string",
          "maxLength": 120,
          "description": "Where it comes from, in a few words: “allergens.csv row 14”, “Menu photo, 12:04”. For a claim, who and how: “Green Bowl, by phone” (shown as “Said by Green Bowl, by phone”).",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/Url"
        },
        "at": {
          "$ref": "#/$defs/Time"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "description": "Why a claim is believed. Shown under the criterion or item it supports; tap opens url."
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Id"
        },
        "state": {
          "enum": [
            "done",
            "failed",
            "rejected",
            "cancelled",
            "expired",
            "elsewhere"
          ],
          "description": "What happened: done; failed (with the reason; the person can Retry); rejected (the person said no); cancelled (the agent withdrew it); expired; elsewhere (answered on another device or platform)."
        },
        "at": {
          "$ref": "#/$defs/Time"
        },
        "by": {
          "type": "string",
          "maxLength": 40,
          "description": "Who answered: “you”, “Maya”, “Studio Mac”."
        },
        "message": {
          "type": "string",
          "maxLength": 120,
          "description": "One line: “Ordered · arrives 12:30 PM”, “The kitchen closed”."
        },
        "undo": {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/$defs/Id"
            },
            "until": {
              "$ref": "#/$defs/Time"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "until"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "at"
      ],
      "description": "The outcome of the widget’s action, set by the agent when it updates the widget."
    }
  }
}
