{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*cua-driver.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-cua-acting.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-cua-acting.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-cua-acting.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
