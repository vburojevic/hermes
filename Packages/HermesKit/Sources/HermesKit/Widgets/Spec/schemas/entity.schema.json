{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermesapp.dev/schemas/widgets/entity.schema.json",
  "title": "entity",
  "description": "One thing — a listing, product, person, place, event, file, link, review or pull request — as a card with its visual, the facts that matter and what to do next.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "listing"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "price"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "product"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "price"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "place"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "place"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "event"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "when"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "file"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "file",
          "url"
        ],
        "properties": {
          "file": {
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "link"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "url"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "rating",
          "body"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pull_request"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "pull_request"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "gone": {
            "const": true
          }
        },
        "required": [
          "gone"
        ]
      },
      "then": {
        "required": [
          "empty_text"
        ]
      }
    }
  ],
  "properties": {
    "type": {
      "const": "entity"
    },
    "v": {
      "const": 1
    },
    "fallback_text": {
      "type": "string",
      "maxLength": 2000,
      "description": "≤ 2,000 characters for a single widget."
    },
    "kind": {
      "enum": [
        "listing",
        "product",
        "person",
        "place",
        "event",
        "file",
        "link",
        "review",
        "pull_request",
        "other"
      ],
      "description": "The recipe: which visual position and facts the client lays out. other: the generic layout for anything else (a book, a wine, a car)."
    },
    "visual": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/Leading"
        }
      ],
      "description": "The visual. Remote images are fetched by the gateway when the widget is created and served from it, never hot-linked; maps and faces are drawn on the device."
    },
    "visual_position": {
      "enum": [
        "auto",
        "top",
        "leading",
        "trailing"
      ],
      "description": "auto follows the kind: top for listing, product, place; leading for person, event, file, other; trailing for link.",
      "default": "auto"
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 80,
      "description": "The small line above the name: “For sale · Park Slope, Brooklyn”, “Mila_R · Trailhead 1.3 · today”. For links the client shows the url’s domain instead."
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "description": "The thing’s own name: “412 5th St, Apt 3R”, “Dana Cole”, “Lost my whole list after the update”.",
      "minLength": 1
    },
    "detail": {
      "type": "string",
      "maxLength": 160,
      "description": "The line under the name: “Real estate agent · Brownstone Realty”, “200 W 57th St · 0.3 mi, 5 min walk”."
    },
    "note": {
      "type": "string",
      "maxLength": 120,
      "description": "A smaller third line: “Answers within the hour on weekdays”, “Until 20:00 · busy now”."
    },
    "url": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/Url"
        }
      ],
      "description": "What tapping the card opens, after showing where it goes: the listing page, the link, the file (hermes-file: opens in the Inspector on iPad and Mac, Quick Look on iPhone)."
    },
    "price": {
      "type": "object",
      "properties": {
        "amount": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/Quantity"
            }
          ],
          "description": "The price now. `value: null` with `display: \"Price on request\"` when there is none; never 0."
        },
        "was": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/Quantity"
            }
          ],
          "description": "The earlier price, struck through beside it: a price drop, a sale."
        },
        "change": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/Delta"
            }
          ],
          "description": "The change from `was`, with `good` from the reader’s side: a buyer’s price drop is `good: down`."
        },
        "history": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 60,
          "description": "Price over time, oldest first (daily or per check): drawn as a small step line under the price."
        },
        "lowest": {
          "type": "object",
          "properties": {
            "amount": {
              "$ref": "common.schema.json#/$defs/Quantity"
            },
            "label": {
              "type": "string",
              "maxLength": 40,
              "description": "“Lowest in 90 days”, “All-time low”.",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "amount",
            "label"
          ],
          "description": "The best price seen, as a tag when the price is at or near it."
        },
        "per": {
          "type": "string",
          "maxLength": 16,
          "description": "What the price covers: “/ month”, “/ night”, “per person”."
        },
        "note": {
          "type": "string",
          "maxLength": 40,
          "description": "One short line beside it: “incl. tax”, “+ $40 utilities”."
        }
      },
      "additionalProperties": false,
      "required": [
        "amount"
      ],
      "description": "A price, with what it was."
    },
    "rating": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "The rating; null when there are none yet (“No ratings yet”, never 0 stars)."
        },
        "scale": {
          "type": "integer",
          "description": "The top of the scale.",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        },
        "count": {
          "type": "integer",
          "description": "How many ratings it averages, when it’s an average.",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "description": "Stars (scale 5) or a score (“8.6 / 10”)."
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 40,
            "description": "What it is, for VoiceOver and the fallback: “Bedrooms”, “Floor area”, “Balcony”.",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "maxLength": 24,
            "description": "What the chip shows: “2 bd”, “950 sq ft”. Leave it out for a yes-feature (the chip shows the label)."
          },
          "glyph": {
            "$ref": "common.schema.json#/$defs/Symbol"
          }
        },
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "description": "A fact as a chip."
      },
      "maxItems": 8,
      "description": "Facts as chips, most decisive first."
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Tag"
      },
      "maxItems": 4
    },
    "body": {
      "type": "string",
      "maxLength": 600,
      "description": "Longer text: a review’s words (quoted), a link’s description, a product blurb. Three lines show; the rest behind More (local)."
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Person"
      },
      "maxItems": 12,
      "description": "Faces in a row with names: who’s invited, who’s in a group."
    },
    "when": {
      "type": "object",
      "properties": {
        "start": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Time"
            },
            {
              "$ref": "common.schema.json#/$defs/Date"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Time"
            },
            {
              "$ref": "common.schema.json#/$defs/Date"
            }
          ]
        },
        "all_day": {
          "type": "boolean",
          "default": false
        },
        "response": {
          "enum": [
            "not_answered",
            "accepted",
            "tentative",
            "declined"
          ],
          "description": "The person’s answer to the invite, when it is one."
        }
      },
      "additionalProperties": false,
      "required": [
        "start"
      ],
      "description": "When an event is."
    },
    "place": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "Where, in a few words: “EWR Terminal C”, “200 W 57th St”, “Zoom”.",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "maxLength": 120,
          "description": "The street address when it isn’t the name."
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "url": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/Url"
            }
          ],
          "description": "A call link (Zoom, Meet, FaceTime web) or the place’s page. Join / Open shows the domain first."
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "A place. With lat and lon the row’s menu offers Directions (opens Maps on this device); with url, Join or Open.",
      "dependentRequired": {
        "lat": [
          "lon"
        ],
        "lon": [
          "lat"
        ]
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "maxLength": 24,
          "description": "International format: +1 212 555 0147.",
          "pattern": "^\\+?[0-9][0-9 ()./-]{2,23}$"
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "format": "email"
        },
        "website": {
          "$ref": "common.schema.json#/$defs/Url"
        }
      },
      "additionalProperties": false,
      "description": "Ways to reach a person or place. The client draws the reach buttons from them (Message, Call, Mail, Website); they open on this device and send nothing for you."
    },
    "file": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "description": "Bytes. Formatted by the client (“2.4 MB”).",
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "type": "string",
          "maxLength": 80,
          "description": "Who sent or made it: “from Dana Cole”."
        },
        "modified": {
          "$ref": "common.schema.json#/$defs/Time"
        }
      },
      "additionalProperties": false,
      "description": "Facts about a file; the client writes the detail line from them."
    },
    "pull_request": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "maxLength": 80,
          "description": "owner/name, shown in mono with the number: “alexr/hermes #212”.",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "open",
            "draft",
            "merged",
            "closed"
          ],
          "default": "open"
        },
        "author": {
          "$ref": "common.schema.json#/$defs/Person"
        },
        "base": {
          "type": "string",
          "maxLength": 80,
          "description": "The branch it merges into: main."
        },
        "head": {
          "type": "string",
          "maxLength": 80,
          "description": "The branch it comes from."
        },
        "commits": {
          "type": "integer",
          "minimum": 0
        },
        "additions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "passed",
                "failed",
                "running",
                "none",
                "unknown"
              ],
              "description": "From the forge’s check runs, never from the author’s word. unknown: not read (dashed, “Checks unknown”)."
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "pending": {
              "type": "integer",
              "minimum": 0
            },
            "failing": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 80
              },
              "maxItems": 5,
              "description": "Names of failing checks: “ui-tests (iPhone 17)”."
            }
          },
          "additionalProperties": false,
          "required": [
            "state"
          ]
        },
        "reviews": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "approved",
                "changes_requested",
                "required",
                "none",
                "unknown"
              ]
            },
            "approvals": {
              "type": "integer",
              "minimum": 0
            },
            "required": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "state"
          ]
        },
        "mergeable": {
          "enum": [
            "yes",
            "conflicts",
            "blocked",
            "unknown"
          ],
          "description": "What the forge says; unknown while it is still computing."
        }
      },
      "additionalProperties": false,
      "required": [
        "repo",
        "number",
        "checks"
      ],
      "description": "A pull request’s status: checks, reviews and whether it can merge."
    },
    "gone": {
      "type": "boolean",
      "description": "The thing no longer exists (taken down, deleted, closed). The body is replaced by the tray glyph and the envelope’s `empty_text` (“This listing was taken down.”, required with gone); header and footer stay; the buttons go.",
      "default": false
    }
  },
  "required": [
    "type",
    "v",
    "kind",
    "name"
  ],
  "unevaluatedProperties": false
}
